# ─────────────────────────────────────────────────────────────
# Local secrets — gitignored, never commit this file.
# Moved out of .env.example on 2026-08-11 (that file is meant to
# be a shareable template, not a place for live keys).
# ─────────────────────────────────────────────────────────────

# ── Google PageSpeed Insights ────────────────────────────────
PAGESPEED_API_KEY=AIzaSyDpB6cwT8yQjaOw7L_WM_JDb5cKf7SrMuc

# ── Google Search Console ────────────────────────────────────
# NOTE: this value is shaped like a Google OAuth *client secret*
# (GOCSPX-...), not an access token. GSC_ACCESS_TOKEN expects a
# live OAuth access token (short-lived, from the token endpoint),
# so this almost certainly will not authenticate as-is — double
# check which credential you meant to paste here.
GSC_ACCESS_TOKEN=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
GSC_SITE_URL=https://myassuredhomenursing.com/

# ── Backlink data provider ───────────────────────────────────
# Crawly free tier is ~100 requests/day and a full report costs 2, so the
# provider caches for 10 minutes. Set BACKLINK_PROVIDER=seed to force seeded
# data (e.g. to avoid burning quota while developing).
BACKLINK_PROVIDER=crawly
CRAWLY_API_KEY=crawly_live_6f54003865ffd69e78245e482b975975

# ── Google Ads ────────────────────────────────────────────────
# 135-000-1149 is the client account under the Klezatech MCC (277-092-8398),
# so LOGIN_CUSTOMER_ID is set to the MCC — that's the manager-account header
# required to read a client account through it.
#
# REFRESH_TOKEN is intentionally empty: a Google account is connected via
# Settings -> Connect Google (klezatech@gmail.com, .data/google/oauth.json),
# and that connection is used automatically ahead of this env var — see
# getAccessToken() in googleAdsClient.ts. Only fill this in if you'd rather
# not rely on the stored connection (e.g. a second, non-interactive account).
ADS_PROVIDER=google
GOOGLE_ADS_CUSTOMER_ID=1350001149
GOOGLE_ADS_DEVELOPER_TOKEN=RwVUMutERkR3a9abpHefVA
GOOGLE_ADS_CLIENT_ID=170339477039-cfq2ascsd8piu62056p4jgos2ba299hr.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=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
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=2770928398
