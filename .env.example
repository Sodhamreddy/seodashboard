# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Nothing here is required to
# boot — the app falls back to dev defaults and seeded provider
# data, and every screen tells you which mode it is in.
# ─────────────────────────────────────────────────────────────

# ── Auth (single gated login) ────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-now
# 32+ random chars. Rotating this invalidates all sessions.
AUTH_SECRET=replace-with-a-long-random-string
# Session lifetime in hours
SESSION_HOURS=12

# ── Defaults ─────────────────────────────────────────────────
DEFAULT_DOMAIN=example.com

# ── Google PageSpeed Insights (free, optional) ───────────────
# Enables real Core Web Vitals + Lighthouse scores in SEO Score Checker.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Google Search Console (sitemap submission) ───────────────
# Scope needed: https://www.googleapis.com/auth/webmasters
# Paste a live OAuth access token to enable real submission; without
# it the sitemap tool runs in simulation mode and says so.
GSC_ACCESS_TOKEN=
# Property as registered in Search Console, e.g. https://example.com/
# or sc-domain:example.com
GSC_SITE_URL=https://example.com/

# ── Backlink data provider ───────────────────────────────────
# seed (default) | crawly | custom
BACKLINK_PROVIDER=seed
CRAWLY_API_KEY=

# ── Rank tracking provider ───────────────────────────────────
# seed (default) | seranking | custom
RANK_PROVIDER=seed
SERANKING_API_KEY=

# ── Google Ads ───────────────────────────────────────────────
# seed (default) | google
ADS_PROVIDER=seed
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Digits only, e.g. 2770928398 (no dashes).
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if the account above is managed through an MCC — set this to
# the MCC's id. Omitting it when it's required is the most common 400.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional. Defaults to v22. Bump if calls start returning 404 (version sunset).
GOOGLE_ADS_API_VERSION=

# Optional override. Defaults to <origin>/api/auth/google/callback, which must
# be registered in Google Cloud -> Credentials -> your OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=

# ── Budget alert delivery (optional) ─────────────────────────
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# ── Google Business Profile (GMB Reviews Automation) ──────────────────
# Off by default. `business.manage` is a Google RESTRICTED scope: requesting it
# from a project Google has not approved for the Business Profile APIs can make
# the consent screen warn or fail, taking Search Console / Ads / GA4 with it.
# Turn this on only AFTER Google approves Business Profile API access, then
# reconnect the Google account in Settings.
ENABLE_GMB_SCOPE=false
# Optional: pick one location when the account manages several.
# GMB_LOCATION_ID=

# ── Google Analytics 4 ────────────────────────────────────────────────
# Optional override. Without it the adapter probes name-matching properties and
# picks the one that actually has sessions.
# GA4_PROPERTY_ID=
